SERVER_URL=http://localhost:3001
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Groq Configuration (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Challenge-type specific models
GROQ_MODEL_HTML=openai/gpt-oss-20b
GROQ_MODEL_CSS=openai/gpt-oss-20b
GROQ_MODEL_JAVASCRIPT=openai/gpt-oss-120b
GROQ_MODEL_PYTHON=openai/gpt-oss-120b

GROQ_TIMEOUT_MS=30000
GROQ_MAX_RETRIES=2
GROQ_BACKOFF_BASE_MS=500
GROQ_MAX_TOKENS=1024
GROQ_MAX_TOKENS_RETRY=2048
GROQ_EMPTY_RESPONSE_RETRIES=1

# Circuit Breaker Configuration
MODEL_CB_FAILURES=3
MODEL_CB_COOLDOWN_MS=30000

# Redis
REDIS_URL=redis://localhost:6379

# Rate Limiting
PER_USER_LIMIT=10
GLOBAL_LIMIT=1000

ENABLE_EXTENDED_HEALTH=false

# API Key Authentication (required)
API_KEY=

# Sentry Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry release plumbing — CI BUILD-TIME ONLY.
# Do NOT set these in production runtime env. They're consumed by
# getsentry/action-release (release + source maps) and the sentry-cli
# deploy marker in deploy.yaml. The token lives as a GitHub Actions
# secret; never commit a real value.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Smoke-test targets — loaded from .env by direnv (.envrc) for GET /debug/sentry.
# Ops/local only; the app ignores these. Put real values in .env (gitignored), then `direnv allow`.
SOCRATES_STG_URL=https://socrates.freecodecamp.dev
SOCRATES_PRD_URL=https://socrates.freecodecamp.org
SOCRATES_STG_API_KEY=
SOCRATES_PRD_API_KEY=
