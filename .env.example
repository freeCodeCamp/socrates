SERVER_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=*
LOG_LEVEL=info

# Groq Configuration (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Challenge-type specific models
GROQ_MODEL_HTML=openai/gpt-oss-20b
GROQ_MODEL_CSS=openai/gpt-oss-20b
GROQ_MODEL_JAVASCRIPT=openai/gpt-oss-120b
GROQ_MODEL_PYTHON=openai/gpt-oss-120b

GROQ_TIMEOUT_MS=30000
GROQ_MAX_RETRIES=2
GROQ_BACKOFF_BASE_MS=500
GROQ_MAX_TOKENS=1024
GROQ_MAX_TOKENS_RETRY=2048
GROQ_EMPTY_RESPONSE_RETRIES=1

# Circuit Breaker Configuration
MODEL_CB_FAILURES=3
MODEL_CB_COOLDOWN_MS=30000

# Redis
REDIS_URL=redis://localhost:6379

# Rate Limiting
PER_USER_LIMIT=10
GLOBAL_LIMIT=1000

ENABLE_EXTENDED_HEALTH=false

# API Key Authentication (required)
API_KEY=
