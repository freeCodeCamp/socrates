SERVER_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=*
LOG_LEVEL=info

# Groq Configuration (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Challenge-type specific models
# Use 20b model for simpler challenges (HTML, CSS)
GROQ_MODEL_HTML=openai/gpt-oss-20b
GROQ_MODEL_CSS=openai/gpt-oss-20b
# Use 120b model for more complex challenges (JavaScript, Python)
GROQ_MODEL_JAVASCRIPT=openai/gpt-oss-120b
GROQ_MODEL_PYTHON=openai/gpt-oss-120b

GROQ_TIMEOUT_MS=30000
GROQ_MAX_RETRIES=2
GROQ_BACKOFF_BASE_MS=500

# Circuit Breaker Configuration
MODEL_CB_FAILURES=3
MODEL_CB_COOLDOWN_MS=30000

ENABLE_EXTENDED_HEALTH=false

# API Key Authentication (required in production)
# Generate with: pnpm run generate-api-key
API_KEY=

# API Docs Basic Auth (required in production)
DOCS_BASIC_AUTH_USER=
DOCS_BASIC_AUTH_PASS=