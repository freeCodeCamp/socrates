{
  "name": "socrates",
  "version": "0.1.0",
  "description": "freeCodeCamp AI Hint API - Socrates",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "BUILD_VERSION=dev-$(git rev-parse --short HEAD 2>/dev/null || echo unknown) nodemon",
    "build": "tsc -p . && cp -r src/lib/lua dist/lib/lua",
    "start": "node dist/index.js",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "check": "oxlint . && prettier --check .",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:manual": "ts-node scripts/test-hints.ts",
    "generate-api-key": "ts-node scripts/generate-api-key.ts"
  },
  "author": "",
  "license": "BSD-3-Clause",
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/redis": "^9.0.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@sentry/node": "^10.74.0",
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/sanitize-html": "^2.16.1",
    "nodemon": "^3.1.14",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
