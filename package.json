{
  "name": "thelibrarian",
  "version": "0.1.0",
  "description": "freeCodeCamp AI Hint API - The Librarian",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "lint": "eslint 'src/**/*.{ts,tsx}' --fix || true",
    "format": "prettier --write 'src/**/*.{ts,tsx,json,md,js}'",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:integration": "RUN_OLLAMA_INTEGRATION=true vitest run src/__tests__/ollamaClient.integration.test.ts src/__tests__/hintRoute.integration.test.ts",
    "test:manual": "bash ./scripts/manual-tests.sh",
    "compose:up": "docker-compose up -d",
    "compose:down": "docker-compose down",
    "test:watch": "vitest"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.4.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "helmet": "^6.0.0",
    "ioredis": "^5.3.1",
    "morgan": "^1.10.0",
    "supertest": "^6.3.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.8.2",
    "@types/supertest": "^6.0.3",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.27.5",
    "nodemon": "^2.0.22",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0",
    "vitest": "^1.5.7"
  }
}
