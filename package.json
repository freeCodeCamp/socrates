{
  "name": "socrates",
  "version": "0.1.0",
  "description": "freeCodeCamp AI Hint API - Socrates",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p . && cp -r src/lib dist/",
    "start": "node dist/index.js",
    "lint": "biome check --write .",
    "lint:legacy": "eslint 'src/**/*.{ts,tsx}' --fix || true",
    "format": "biome format --write .",
    "format:legacy": "prettier --write 'src/**/*.{ts,tsx,json,md,js}'",
    "check": "biome check .",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:manual": "bash ./scripts/test-hints.sh",
    "generate-api-key": "ts-node scripts/generate-api-key.ts"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.5",
    "axios": "^1.4.0",
    "dotenv": "^16.0.0",
    "fastify": "^5.7.4",
    "ioredis": "^5.3.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^24.10.14",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.27.5",
    "nodemon": "^2.0.22",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
